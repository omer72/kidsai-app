# Public API base — Netlify Functions deployment URL.
VITE_API_BASE=https://your-site.netlify.app

# RevenueCat public SDK keys (appl_ for iOS, goog_ for Android).
VITE_RC_IOS_KEY=appl_...
VITE_RC_ANDROID_KEY=goog_...
VITE_RC_ENTITLEMENT_ID=premium

# Insert Affiliate company code (dashboard → Settings). Empty = affiliate off.
VITE_IA_COMPANY_CODE=
# RevenueCat Web Purchase Link (RevenueCat → Web Purchase Links → copy URL).
# Insert Affiliate's UTM triplet is appended at runtime.
VITE_RC_WEB_PURCHASE_LINK=https://pay.rev.cat/xxxxxxxxxxxx/

# Anonymous insights. No auth header is sent. Override this in a preview
# build to point QA at a kidsit-website preview instead of production.
VITE_INSIGHTS_URL=https://kidsit.ai/api/insights

# Anonymous funnel counts (one POST per step, once per install, no identifier).
# Point a preview build at a kidsit-website preview, or set to "off" to build
# an app that never reports them.
VITE_FUNNEL_URL=https://kidsit.ai/api/funnel

# Server-side only (Netlify env vars, not this file):
#   RC_SECRET_KEY   RevenueCat secret key, for the entitlement check
#   AUTH_ENFORCE    "true" to turn away callers with no subscription once
#                   their free answers are used. Unset = log-only.
#   FREE_MOMENTS    free answers per install before the paywall. Default 3;
#                   0 = subscribers only.
# OPENAI_API_KEY does NOT belong here — set it as a Netlify env var
# under Site settings → Environment variables (server-side only).
