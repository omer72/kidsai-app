# Public API base — Netlify Functions deployment URL.
VITE_API_BASE=https://your-site.netlify.app

# RevenueCat public SDK keys (appl_ for iOS, goog_ for Android).
VITE_RC_IOS_KEY=appl_...
VITE_RC_ANDROID_KEY=goog_...
VITE_RC_ENTITLEMENT_ID=premium

# Insert Affiliate company code (dashboard → Settings). Empty = affiliate off.
VITE_IA_COMPANY_CODE=
# RevenueCat Web Purchase Link (RevenueCat → Web Purchase Links → copy URL).
# Insert Affiliate's UTM triplet is appended at runtime.
VITE_RC_WEB_PURCHASE_LINK=https://pay.rev.cat/xxxxxxxxxxxx/

# OPENAI_API_KEY does NOT belong here — set it as a Netlify env var
# under Site settings → Environment variables (server-side only).
