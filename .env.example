# Public API base — Netlify Functions deployment URL.
VITE_API_BASE=https://your-site.netlify.app

# RevenueCat iOS public SDK key (appl_ for production, test_ for sandbox).
VITE_RC_IOS_KEY=appl_...
VITE_RC_ENTITLEMENT_ID=premium

# OPENAI_API_KEY does NOT belong here — set it as a Netlify env var
# under Site settings → Environment variables (server-side only).
